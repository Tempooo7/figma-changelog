   "locked": false
  },
  {
   "id": "3YkTftHTRQwf5ZqUup4n",
   "type": "text",
   "x": 914,
   "y": 453.75,
   "width": 866.32,
   "height": 212.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "RhbYsqpiYgUYKfNCcbfo",
   "roundness": null,
   "seed": 316440230,
   "version": 1,
   "versionNonce": 52453128,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Things to know before we build\n•  Channels are optional: add a channel's secrets → it turns on; leave them out → off\n•  Each channel remembers its own last-sent version, so one failing never blocks the others\n•  The Figma token must come from a Full or Dev seat on a paid plan (not View/Collab)\n•  Below Enterprise, the API gives variable IDs, not names → names come from\n    variables-map.json (exported by a tiny private plugin), else style name, else hex\n•  Figma picture links expire after ~30 days → PNG copies are saved in the repo\n•  Figma autosaves count as versions → one hour can hold several versions\n•  GitHub may start scheduled runs a few minutes late (harmless)\n•  Secrets live only in GitHub secrets / your local .env, never in chat or code",
   "originalText": "Things to know before we build\n•  Channels are optional: add a channel's secrets → it turns on; leave them out → off\n•  Each channel remembers its own last-sent version, so one failing never blocks the others\n•  The Figma token must come from a Full or Dev seat on a paid plan (not View/Collab)\n•  Below Enterprise, the API gives variable IDs, not names → names come from\n    variables-map.json (exported by a tiny private plugin), else style name, else hex\n•  Figma picture links expire after ~30 days → PNG copies are saved in the repo\n•  Figma autosaves count as versions → one hour can hold several versions\n•  GitHub may start scheduled runs a few minutes late (harmless)\n•  Secrets live only in GitHub secrets / your local .env, never in chat or code",
   "fontSize": 17,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "L6autoC3NPSvEDDUoHF3",
   "lineHeight": 1.25,
   "autoResize": true
  },
