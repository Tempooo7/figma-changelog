   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Same Update everywhere: header “<project>: N changes · author · time”, version label, bullets by page, main before/after pair, Open in Figma,\nthen one reply per remaining frame (max 6 pictured frames, “+N more” for the rest). Labels (Before/After/New) come from config.json.",
   "originalText": "Same Update everywhere: header “<project>: N changes · author · time”, version label, bullets by page, main before/after pair, Open in Figma,\nthen one reply per remaining frame (max 6 pictured frames, “+N more” for the rest). Labels (Before/After/New) come from config.json.",
   "fontSize": 17,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "dMJnZFHbhTKmbs3oq6W6",
