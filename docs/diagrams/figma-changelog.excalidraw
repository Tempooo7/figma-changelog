  {
   "id": "uHuTBvAVtLinBTzUYmQM",
   "type": "text",
   "x": 54,
   "y": 436.25,
   "width": 554.4000000000001,
   "height": 247.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "RhbYsqpiYgUYKfNCcbfo",
