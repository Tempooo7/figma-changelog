   "link": null,
   "locked": false,
   "text": "src/channels/<name>.js\n\nexport default {\n  name: 'slack',\n  isConfigured(env),\n    // secrets present? else off\n  async sendMain(update),\n    // → thread reference\n  async sendReply(ref, pair),\n  preview(update)\n    // --dry-run: print payload\n}",
   "originalText": "src/channels/<name>.js\n\nexport default {\n  name: 'slack',\n  isConfigured(env),\n    // secrets present? else off\n  async sendMain(update),\n    // → thread reference\n  async sendReply(ref, pair),\n  preview(update)\n    // --dry-run: print payload\n}",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "j3NBdu9tom5YGahLxe8c",
