   "updated": 1,
   "link": null,
   "locked": false,
   "text": "on:\n  schedule:\n    - cron: '7 * * * *'        # every hour at :07 (UTC)\n  workflow_dispatch:           # manual “Run workflow”\nconcurrency:\n  group: figma-changelog       # never two runs at once",
   "originalText": "on:\n  schedule:\n    - cron: '7 * * * *'        # every hour at :07 (UTC)\n  workflow_dispatch:           # manual “Run workflow”\nconcurrency:\n  group: figma-changelog       # never two runs at once",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
