# Copy this file to ".env" (same folder) and fill in the values.
# .env is git-ignored: it stays on your computer and is never committed.
# For the automatic runs, the same names go into GitHub › Settings › Secrets.

# --- Figma (required) ---
# Personal access token from a Full or Dev seat.
# Scopes: File content (read) + File versions (read).
FIGMA_TOKEN=
# The file link, or just the key from it (figma.com/design/<KEY>/...)
FIGMA_FILE_KEY=

# --- Google Chat (optional) ---
GCHAT_WEBHOOK_URL=

# --- Slack (optional) ---
# Bot mode (supports threads): Slack app bot token + channel ID
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# ...or simple webhook mode (no threads; everything in one message)
SLACK_WEBHOOK_URL=

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only for forum groups with topics:
TELEGRAM_TOPIC_ID=
